// Renovate config for Linterpol.
// .jsonc (JSON-with-comments), like chrysalis: Renovate recommends it for commented configs
// and editors validate it against the schema below natively.
// Options reference: https://docs.renovatebot.com/configuration-options/
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // config:best-practices digest-pins Docker images and SHA-pins Actions; weekly PRs.
  "extends": ["config:best-practices", "schedule:weekly"],

  // Managers in play: dockerfile (the FROM tag@digest pins), github-actions (the workflow
  // action SHAs), custom.regex (the Lane-2 downloaded-binary versions, marked below).
  "enabledManagers": ["dockerfile", "github-actions", "custom.regex"],

  "customManagers": [
    {
      // Lane-2 downloaded binaries (container-structure-test, swiftlint) have no usable multi-arch
      // image, so each is pinned by an `ARG <NAME>_VERSION` in the Dockerfile (see that file's
      // Lane-2 stages). Renovate tracks each release tag here; regen-linters.yml then refreshes
      // LINTERS.md on the bump PR.
      "description": "Track Lane-2 downloaded-binary versions (ARG <NAME>_VERSION) pinned in the Dockerfile.",
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      // Marker line `# renovate: datasource=… depName=…` then `ARG <NAME>_VERSION=<value>`;
      // datasource + depName come from the marker, currentValue is the version.
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\w+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ]
}
