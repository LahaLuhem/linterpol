// Renovate config for Linterpol.
// .jsonc (JSON-with-comments): Renovate recommends it for commented configs
// and editors validate it against the schema below natively.
// Options reference: https://docs.renovatebot.com/configuration-options/
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // config:best-practices digest-pins Docker images and SHA-pins Actions, with weekly PRs.
  "extends": ["config:best-practices", "schedule:weekly"],

  // Managers in play: dockerfile (the FROM tag@digest pins), github-actions (the workflow
  // action SHAs), custom.regex (the Lane-2 tool versions and biome.json's $schema version, both
  // below).
  "enabledManagers": ["dockerfile", "github-actions", "custom.regex"],

  // Automerge only the boring tier. Safe here because a push to main publishes nothing: a bare
  // semver tag does (see APPENDIX#versioning-releases), so the release gate stays manual either way.
  // Use GitHub's native auto-merge rather than Renovate's branch automerge, so a Dockerfile bump
  // still opens a PR and regen-linters.yml can commit the refreshed LINTERS.md to it before merge.
  "platformAutomerge": true,
  // This repo allows rebase-merge only, and main requires linear history. Leaving the strategy to
  // the platform default would try a merge commit and be rejected.
  "automergeStrategy": "rebase",
  // Without this, regen-linters.yml's commit makes Renovate refuse to rebase the branch.
  "gitIgnoredAuthors": [
    "287673903+lahaluhem-ci-bot[bot]@users.noreply.github.com"
  ],
  "packageRules": [
    {
      // Majors stay manual: they set the next release's bump level (README#what-a-bump-level-means).
      // A minor can still shift a tool's rules. CI catching that (hadolint 2.15's DL3066) is the bet.
      "description": "Automerge everything below major: digests, re-pins, tool patches and minors.",
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "automerge": true
    },
    {
      // Two deps (the image's FROM tag and biome.json's $schema URL) that must not drift apart.
      "description": "Keep the biome image and biome.json's $schema version in one PR.",
      "matchPackageNames": ["ghcr.io/biomejs/biome", "@biomejs/biome"],
      "groupName": "biome"
    }
  ],

  "customManagers": [
    {
      // Lane-2 tools have no usable multi-arch image, so each is pinned by an `ARG <NAME>_VERSION`
      // in its image's Dockerfile. regen-linters.yml then refreshes LINTERS.md on the bump PR.
      "description": "Track the Lane-2 tool versions (ARG <NAME>_VERSION) pinned in the Dockerfiles.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      // Marker line `# renovate: datasource=… depName=…` then `ARG <NAME>_VERSION=<value>`. The
      // marker gives datasource + depName, and the ARG's value is currentValue.
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\w+_VERSION=(?<currentValue>\\S+)"
      ]
    },
    {
      // biome.json's `$schema` URL embeds Biome's version as plain text, which the dockerfile
      // manager can't see. Track it via npm, where @biomejs/biome uses the same versions.
      "description": "Track the Biome version in biome.json's $schema URL (kept in sync with the image).",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)biome\\.json$/"],
      "matchStrings": [
        "biomejs\\.dev/schemas/(?<currentValue>\\d+\\.\\d+\\.\\d+)/schema\\.json"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@biomejs/biome"
    }
  ]
}
